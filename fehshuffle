#! /usr/bin/env bash

# DISPLAY may not be set, e.g., when ran from cron
: "${DISPLAY:=":0"}"
# The path to choose images from
bgdir="/usr/share/backgrounds"
# The (created) shuffled background choices
backgrounds="${HOME}/.fehchoices"

if DISPLAY="$DISPLAY" xset q 2>/dev/null | grep -q 'Monitor is Off' ; then
  # Don't run if the display is off
  exit 0
elif DISPLAY="$DISPLAY" xscreensaver-command -time 2>/dev/null |
    grep -qE 'screen (blanked|locked)' ; then
  # Don't run if xscreensaver is running
  exit 0
fi

# An argument is given when used as a startup script
if [ -n "$1" ] ; then
  # commands here run once on X login, with a slight delay
  xrdb -merge "${HOME}/.Xresources"
  # Restore the last background
  if [ -x "${HOME}/.fehbg" ] ; then
    "${HOME}/.fehbg"
    exit 0
  fi
  # No background to restore, proceed to set a background
fi

# Fill the choice list
if [ ! -f "$backgrounds" ] || [ ! -s "$backgrounds" ] ; then
  # The list of choices
  shopt -s nullglob
  list=("$bgdir"/*)
  # shuffle and write to file
  shuf -e -o "$backgrounds" "${list[@]}"
fi

# Choose the last
bg="$(tail -n1 "$backgrounds")"

# Remove the last from the choice list
tmpfile="$(mktemp)"
head -n -1 "$backgrounds" > "$tmpfile"
mv "$tmpfile" "$backgrounds"

# Set the background
DISPLAY="$DISPLAY" /usr/bin/feh -z --bg-fill "$bg"
